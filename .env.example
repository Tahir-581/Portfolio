# Gmail SMTP — used by /api/request to send Buy Now form leads
EMAIL_USERNAME=your@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM="Tesoora Leads <your@gmail.com>"
# Inbox that receives leads (defaults to EMAIL_USERNAME). Must be a real mailbox with MX.
EMAIL_TO=your@gmail.com

# Public site URL for absolute links/images in customer emails
SITE_URL=https://portfolio-five-chi-43.vercel.app

# Optional overrides (defaults shown)
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
